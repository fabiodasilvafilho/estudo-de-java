import java.util.Scanner;

public class Main {
	public static void main(String[] args) {
	    Scanner sc = new Scanner(System.in);
	    double[] notas = new double[10]; // inicializar variável com a lista e seu tamanho.
	    
	    for(int i = 0; i < 10; i++){ // scanner para automatizar 10 inputs.
	        System.out.print("Digite uma nota: ");
    	    notas[i] = sc.nextDouble();
	    }
	    double menorNota = notas[0]; // a nota selecionada (menor) sempre será a primeira.
	    for(int i = 1; i < 10; i++){
	        if(notas[i] < menorNota){
	            menorNota = notas[i];
	        }
	    }
	    System.out.println(menorNota);
	}
}
